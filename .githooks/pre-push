#!/usr/bin/env bash
set -euo pipefail

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    if [[ ! "${ZCC_CHANGE_ISSUE:-}" =~ ^[0-9]+$ ]]; then
      echo "A reviewed GitHub Issue number is required for a main update."
      echo "Set ZCC_CHANGE_ISSUE to the accepted Issue number."
      exit 1
    fi
    if [[ "${ZCC_APPROVING_MAINTAINER:-}" != "kpex-sd" &&
          "${ZCC_APPROVING_MAINTAINER:-}" != "cpsd038" ]]; then
      echo "Set ZCC_APPROVING_MAINTAINER to the other appointed maintainer."
      exit 1
    fi
    echo "Reminder: independent model review is recommended administrative practice,"
    echo "but it is not a required or technically attested push gate."
    if [[ "$_remote_sha" == "0000000000000000000000000000000000000000" ]]; then
      echo "Refusing an unexpected creation of main."
      exit 1
    fi
    if ! git merge-base --is-ancestor "$_remote_sha" "$_local_sha"; then
      echo "Refusing a non-fast-forward update to main."
      exit 1
    fi
  fi
  if [[ "$_local_sha" != "0000000000000000000000000000000000000000" ]]; then
    if [[ "$_remote_sha" == "0000000000000000000000000000000000000000" ]]; then
      # A new remote branch may contain several local commits. Scan all commits
      # introduced relative to protected main, not merely the tip.
      range="origin/main..$_local_sha"
    else
      range="$_remote_sha..$_local_sha"
    fi
    python scripts/check_public_tree.py --commits-range "$range"
    if [[ "$_remote_sha" != "0000000000000000000000000000000000000000" ]]; then
      python scripts/check_dco.py "$_remote_sha" "$_local_sha"
    fi
  fi
done

python scripts/check_privacy_architecture.py
python -m pytest -q
